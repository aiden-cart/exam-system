<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.exam.mapper.RecordMapper">
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        insert into exam_record(user_id,paper_id,score) values(#{userId},#{paperId},#{score})
    </insert>
    <!-- 关联查询结果映射 -->
    <resultMap id="recordWithPaperMap" type="com.exam.entity.ExamRecord">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="paper_id" property="paperId"/>
        <result column="score" property="score"/>
        <result column="create_time" property="createTime"/>
        
        <!-- 关联 ExamPaper 对象 -->
        <association property="paper" javaType="com.exam.entity.ExamPaper">
            <id column="pid" property="id"/>
            <result column="paper_name" property="paperName"/>
            <result column="limit_time" property="limitTime"/>
        </association>
    </resultMap>
    <!-- 查询用户的所有考试记录（关联查询试卷） -->
    <select id="selectByUserId" resultMap="recordWithPaperMap">
        SELECT 
            r.id,
            r.user_id,
            r.paper_id,
            r.score,
            r.create_time,
            p.id AS pid,
            p.paper_name,
            p.limit_time
        FROM exam_record r
        LEFT JOIN exam_paper p ON r.paper_id = p.id
        WHERE r.user_id = #{userId}
        ORDER BY r.create_time DESC
    </select>
</mapper>